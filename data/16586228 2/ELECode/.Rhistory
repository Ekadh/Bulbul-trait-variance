propSpecEmerged<-NSpecEmerged/nSpec
focRow<-match(names(HorizonList),output[[1]]$WorldID)
#assign results from calcEmStats to master matrix, keeping empty rows NA
NEmerged[focRow,i,xx]<-NSpecEmerged
PropEmerged[focRow,i,xx]<-propSpecEmerged
}
print(i)
}
