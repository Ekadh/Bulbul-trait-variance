#Method 2: Highlighting species with specimen measurements in the SYSU dataset, and comparing those to the AVONET means for those species
cdt2_species <- cdt2_points %>%
    filter(!is.na(Wing.Length_specimen)) %>%
    pull(AviList) %>%
    unique()
cdt2_species
avonet_points_filtered <- avonet_points %>%
    dplyr::filter(AviList %in% cdt2_species)
avonet_long <- avonet_points_filtered %>%
  pivot_longer(
    cols = ends_with("_specimen"),
    names_to = "Trait",
    names_pattern = "(.*)_specimen",
    values_to = "specimen"
  ) %>%
  pivot_longer(
    cols = ends_with("_mean"),
    names_to = "Trait_mean",
    names_pattern = "(.*)_mean",
    values_to = "mean"
  ) %>%
  filter(Trait == Trait_mean) %>%
  dplyr::select(AviList, Trait, specimen, mean)
cdt2_long <- cdt2_points %>%
  pivot_longer(
    cols = ends_with("_specimen"),
    names_to = "Trait",
    names_pattern = "(.*)_specimen",
    values_to = "specimen"
  ) %>%
  pivot_longer(
    cols = ends_with("_mean"),
    names_to = "Trait_mean",
    names_pattern = "(.*)_mean",
    values_to = "mean"
  ) %>%
  filter(Trait == Trait_mean) %>%
  dplyr::select(AviList, Trait, specimen, mean)
ggplot() +
